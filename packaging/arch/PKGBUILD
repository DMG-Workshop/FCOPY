# shellcheck shell=bash
# shellcheck disable=SC2034,SC2154
# Tagged upstream sources; VCS sources intentionally use SKIP rather than an archive checksum.
pkgname=fcopy
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast, verified file copying (CLI + GUI)"
arch=('x86_64' 'aarch64')
url="https://github.com/DMG-Workshop/FCOPY"
license=('MIT' 'Apache-2.0')
depends=('gcc-libs' 'glibc' 'openssl' 'ca-certificates' 'libxkbcommon'
         'libxkbcommon-x11' 'libglvnd' 'libx11' 'libxcursor' 'libxi'
         'libxrandr' 'wayland' 'hicolor-icon-theme')
optdepends=('mesa: Mesa graphics drivers')
makedepends=('cargo' 'git' 'cmake' 'pkgconf')
source=("fcopy::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd fcopy || return
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd fcopy || return
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p fc-cli -p fc-gui
}

check() {
  cd fcopy || return
  cargo test --frozen -p fc-engine -p fc-gui
}

package() {
  cd fcopy || return
  bash packaging/linux/install.sh "$pkgdir"
}
